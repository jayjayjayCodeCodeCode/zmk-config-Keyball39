#define DEFAULT 0
#define AUTO_MOUSE 1
#define SYM     2
#define MOUSE   3
#define CODEX   4
#define SCROLL  5
#define SNIPE   6
#define CMD     7

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    // custom shift using mod-morph 

    behaviors {
        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        cmd_esc: cmd_escape {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&cmd_hold>, <&kp>;
        };
    };

    macros {
        cmd_hold: cmd_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings
                = <&macro_press &mo CMD &kp LGUI>
                , <&macro_pause_for_release>
                , <&macro_release &kp LGUI &mo CMD>
                ;
            label = "Hold CMD";
        };

        Hiragana: Hiragana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "HIRAGANA";
        };

        cdx_fast: codex_fast { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(LA(LG(F)))>; label = "Fast"; };
        cdx_review: codex_review { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(LS(G))>; label = "Review"; };
        cdx_terminal: codex_terminal { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(GRAVE)>; label = "Terminal"; };
        cdx_plan: codex_plan { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(LA(LG(P)))>; label = "Plan"; };
        cdx_fork: codex_fork { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(LA(LG(K)))>; label = "Fork"; };
        cdx_approve: codex_approve { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp ENTER>; label = "Approve"; };
        cdx_sidebar: codex_sidebar { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LG(B)>; label = "Sidebar"; };
        cdx_dictate: codex_dictate { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(LS(D))>; label = "Dictate"; };
        cdx_find: codex_find { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LG(F)>; label = "Find"; };
        cdx_search: codex_search { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LG(G)>; label = "Search"; };
        cdx_branch: codex_branch { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(LA(LG(B)))>; label = "Branch"; };
        cdx_commit: codex_commit { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(LA(LG(C)))>; label = "Commit"; };
        cdx_create_pr: codex_create_pr { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(LA(LG(R)))>; label = "Create PR"; };
        cdx_draft_pr: codex_draft_pr { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(LA(LG(D)))>; label = "Draft PR"; };
        cdx_settings: codex_settings { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LG(COMMA)>; label = "Settings"; };
        cdx_merge_pr: codex_merge_pr { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(LA(LG(M)))>; label = "Merge PR"; };
        cdx_reject: codex_reject { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp ESCAPE>; label = "Reject"; };
        cdx_commands: codex_commands { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LG(LS(P))>; label = "Commands"; };
        cdx_review_panel: codex_review_panel { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LG(LA(B))>; label = "Review Panel"; };
        cdx_browser: codex_browser { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LG(T)>; label = "Browser"; };
        cdx_new_chat: codex_new_chat { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LG(N)>; label = "New Chat"; };
        cdx_folder: codex_folder { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LG(O)>; label = "Folder"; };
        cdx_reason_dn: codex_reason_dn { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(LA(LG(MINUS)))>; label = "Reason Down"; };
        cdx_reason_up: codex_reason_up { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LC(LA(LG(EQUAL)))>; label = "Reason Up"; };
        cdx_shortcuts: codex_shortcuts { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp LG(LS(SLASH))>; label = "Shortcuts"; };
    };

    combos {
        compatible = "zmk,combos";

        snipe_bootloader {
            timeout-ms = <75>;
            key-positions = <0 1>;
            layers = <SNIPE>;
            bindings = <&bootloader>;
        };

        sym_bluetooth_clear {
            timeout-ms = <75>;
            key-positions = <0 1>;
            layers = <SYM>;
            bindings = <&bt BT_CLR>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&kp Q      &kp W         &kp E     &kp R         &kp T                                    &kp Y            &kp U  &kp I      &kp O    &kp P
&kp A      &kp S         &kp D     &kp F         &kp G                                    &kp H            &kp J  &kp K      &kp L    &kp SEMI
&kp Z      &kp X         &kp C     &kp V         &kp B                                    &kp N            &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL  &lt SCROLL LG(GRAVE)  &kp LALT       &cmd_esc 0 ESCAPE  &lt MOUSE SPACE  &kp LGUI  &kp ENTER  &lt SYM BACKSPACE                             &kp RSHFT
            >;
        };

        auto_mouse_layer {
            label = "AUTO_MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &mkp LCLK  &trans  &mkp RCLK  &mkp MCLK
&trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                         &trans
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT                  &kp CARET       &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans                       &kp MINUS       &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp SQT
&trans           &trans        &trans        &trans        &trans                       &kp UNDERSCORE  &kp PLUS       &trans            &trans                &kp NON_US_BACKSLASH
&trans           &trans        &trans        &trans        &trans       &trans  &trans  &trans                                                                 &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&kp N1          &kp N2          &kp N3        &kp N4     &kp N5                  &kp N6         &kp N7     &kp N8  &kp N9     &kp N0
&kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &mo SNIPE               &kp PAGE_UP    &mkp LCLK  &none   &mkp RCLK  &mkp MCLK
&none           &none           &none         &none      &kp TAB                 &kp PAGE_DOWN  &none      &none   &none      &none
&none           &trans          &trans        &trans     &trans  &trans  &trans  &mo CODEX                                    &none
            >;
        };

        codex_layer {
            label = "CODEX";
            bindings = <
&kp C_BRI_DN     &kp C_BRI_UP     &cdx_fast      &cdx_review        &cdx_terminal                  &cdx_plan      &cdx_fork       &kp C_MUTE        &kp C_VOL_DN     &kp C_VOL_UP
&cdx_approve     &cdx_sidebar     &cdx_dictate   &cdx_find          &cdx_search                    &cdx_branch    &cdx_commit     &cdx_create_pr   &cdx_draft_pr   &cdx_settings
&cdx_merge_pr    &cdx_reject      &cdx_commands  &cdx_review_panel  &cdx_browser                   &cdx_new_chat  &cdx_folder     &cdx_reason_dn   &cdx_reason_up  &cdx_shortcuts
&trans            &trans            &trans            &trans                &trans          &trans  &trans  &trans                                             &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT                     &kp CARET       &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &kp PIPE                        &kp MINUS       &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp SQT
&trans           &trans        &trans        &trans        &kp BACKSLASH                   &kp UNDERSCORE  &kp PLUS       &kp LEFT_BRACE    &kp RIGHT_BRACE       &kp DQT
&trans           &trans        &trans        &trans        &trans          &trans  &trans  &trans                                                             &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans                          &trans
            >;
        };

        cmd_layer {
            label = "CMD";
            bindings = <
&kp LS(TAB)  &kp TAB  &sl CODEX  &trans  &trans                  &trans  &trans  &trans                  &kp MINUS              &kp PLUS
&kp N1       &kp N2   &kp N3     &kp N4  &kp N5                  &trans  &trans  &kp LS(LEFT_BRACKET)  &kp LS(RIGHT_BRACKET)  &trans
&trans       &trans   &trans     &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans       &trans   &trans     &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };
    };
};
