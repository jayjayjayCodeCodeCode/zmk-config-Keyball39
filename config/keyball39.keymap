#define DEFAULT 0
#define NUM     1
#define SYM     2
#define MOUSE   3
#define CODEX   4
#define SCROLL  5
#define SNIPE   6
#define CMD     7

#include <behaviors/mouse_keys.dtsi>
#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define CDX_FAST         LC(LA(LG(F)))
#define CDX_REVIEW       LC(LS(G))
#define CDX_TERMINAL     LC(GRAVE)
#define CDX_PLAN         LC(LA(LG(P)))
#define CDX_FORK         LC(LA(LG(K)))
#define CDX_APPROVE      ENTER
#define CDX_SIDEBAR      LG(B)
#define CDX_DICTATE      LC(LS(D))
#define CDX_FIND         LG(F)
#define CDX_SEARCH       LG(G)
#define CDX_BRANCH       LC(LA(LG(B)))
#define CDX_COMMIT       LC(LA(LG(C)))
#define CDX_CREATE_PR    LC(LA(LG(R)))
#define CDX_DRAFT_PR     LC(LA(LG(D)))
#define CDX_SETTINGS     LG(COMMA)
#define CDX_MERGE_PR     LC(LA(LG(M)))
#define CDX_REJECT       ESCAPE
#define CDX_COMMANDS     LG(LS(P))
#define CDX_REVIEW_PANEL LG(LA(B))
#define CDX_BROWSER      LG(T)
#define CDX_NEW_CHAT     LG(N)
#define CDX_FOLDER       LG(O)
#define CDX_REASON_DN    LC(LA(LG(MINUS)))
#define CDX_REASON_UP    LC(LA(LG(EQUAL)))
#define CDX_SHORTCUTS    LG(LS(SLASH))

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <150>;
};

&caps_word { continue-list = <UNDERSCORE MINUS>; };

/ {
    // custom shift using mod-morph 

    behaviors {
        cmqus: comma_question {
            compatible = "zmk,behavior-mod-morph";
            label = "COMMA_QUESTION";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp QUESTION>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        dtsmi: dot_semi {
            compatible = "zmk,behavior-mod-morph";
            label = "DOT_SEMI";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp SEMI>;

            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    macros {
        Hiragana: Hiragana {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(SPACE)>;
            label = "HIRAGANA";
        };
    };

    combos {
        compatible = "zmk,combos";

        cmd_layer {
            timeout-ms = <75>;
            key-positions = <30 32>; // Left Ctrl + Left Option
            layers = <DEFAULT>;
            bindings = <&sl CMD>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "QWRT";
            bindings = <
&kp Q      &kp W         &kp E     &kp R         &kp T                                    &kp Y            &kp U  &kp I      &kp O    &kp P
&kp A      &kp S         &kp D     &kp F         &kp G                                    &kp H            &kp J  &kp K      &kp L    &kp SEMI
&kp Z      &kp X         &kp C     &kp V         &kp B                                    &kp N            &kp M  &kp COMMA  &kp DOT  &kp SLASH
&kp LCTRL  &kp LGUI      &kp LALT       &lt SNIPE ESCAPE  &lt MOUSE SPACE  &lt SCROLL LG(GRAVE)  &kp ENTER  &lt SYM BACKSPACE                             &kp RSHFT
            >;
        };

        number_layer {
            label = "NUM";
            bindings = <
&kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5                  &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&kp LEFT      &kp DOWN      &kp UP_ARROW  &kp RIGHT     &none                         &none         &none         &none         &none         &none
&none         &none         &none         &none         &none                         &none         &none         &trans        &trans        &none
&trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans                                                  &trans
            >;
        };

        symbol_layer {
            label = "SYM";
            bindings = <
&kp EXCLAMATION  &kp AT_SIGN   &kp HASH      &kp DOLLAR    &kp PERCENT                  &kp CARET       &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&bt BT_CLR       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans                       &kp MINUS       &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp SQT
&trans           &trans        &trans        &trans        &trans                       &kp UNDERSCORE  &kp PLUS       &trans            &trans                &kp NON_US_BACKSLASH
&trans           &trans        &trans        &trans        &trans       &trans  &trans  &trans                                                                 &trans
            >;
        };

        mouse_layer {
            label = "MOUSE";
            bindings = <
&kp N1          &kp N2          &kp N3        &kp N4     &kp N5                  &kp N6         &kp N7     &kp N8  &kp N9     &kp N0
&kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &none                   &kp PAGE_UP    &mkp LCLK  &none   &mkp RCLK  &mkp MCLK
&none           &none           &none         &none      &none                   &kp PAGE_DOWN  &none      &none   &none      &none
&none           &trans          &trans        &trans     &trans  &trans  &trans  &mo CODEX                                    &none
            >;
        };

        codex_layer {
            label = "CODEX";
            bindings = <
&kp C_BRI_DN      &kp C_BRI_UP      &kp CDX_FAST      &kp CDX_REVIEW        &kp CDX_TERMINAL                  &kp CDX_PLAN      &kp CDX_FORK       &kp C_MUTE         &kp C_VOL_DN      &kp C_VOL_UP
&kp CDX_APPROVE   &kp CDX_SIDEBAR   &kp CDX_DICTATE   &kp CDX_FIND          &kp CDX_SEARCH                    &kp CDX_BRANCH    &kp CDX_COMMIT     &kp CDX_CREATE_PR  &kp CDX_DRAFT_PR  &kp CDX_SETTINGS
&kp CDX_MERGE_PR  &kp CDX_REJECT    &kp CDX_COMMANDS  &kp CDX_REVIEW_PANEL  &kp CDX_BROWSER                   &kp CDX_NEW_CHAT  &kp CDX_FOLDER     &kp CDX_REASON_DN  &kp CDX_REASON_UP &kp CDX_SHORTCUTS
&trans            &trans            &trans            &trans                &trans          &trans  &trans  &trans                                             &trans
            >;
        };

        scroll_layer {
            label = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans                          &trans
            >;
        };

        snipe_layer {
            label = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &bootloader                  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans       &trans  &trans  &trans                          &trans
            >;
        };

        cmd_layer {
            label = "CMD";
            bindings = <
&none        &kp LG(W)  &sl CODEX  &kp LG(R)  &kp LG(T)                  &none  &none  &none  &none  &none
&kp LG(A)    &kp LG(S)  &none      &kp LG(F)  &kp LG(G)                  &none  &none  &none  &none  &none
&none        &kp LG(X)  &kp LG(C)  &kp LG(V)  &none                      &none  &none  &none  &none  &none
&kp LG(TAB)  &kp LG(LS(TAB))  &none  &none  &none  &none  &none  &none              &none
            >;
        };
    };
};
